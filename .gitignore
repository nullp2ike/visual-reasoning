node_modules/
dist/
_site/
coverage/
.env
*.tgz
*.tsbuildinfo
.DS_Store
.history/

# Benchmark datasets and results are tracked, so the seeded-defect ground truth
# and the runs graded against it have a home outside one laptop. A `private`
# dataset is the exception: it is for screenshots of real product UI, and its
# run records quote model output about them verbatim. Keep these patterns even
# if no such dataset exists: nothing under them is ever committed or published.
bench/datasets/private/
bench/results/private/

# Video bug-hunting harness: recordings are private product footage and results
# quote model output about them verbatim, so neither is tracked.
bench/video/videos/*
!bench/video/videos/.gitkeep
bench/video/results/

# PowerPoint decks: slide material drafted alongside this repo, not part of it.
*.pptx
*.potx
*.ppt
