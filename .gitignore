node_modules/
dist/
coverage/
.env
*.tgz
*.tsbuildinfo
.DS_Store
.history/

# Benchmark datasets and results are tracked, so the seeded-defect ground truth
# and the runs graded against it have a home outside one laptop. The `primary`
# dataset is the exception: those screenshots are private product UI, and its
# run records quote model output about them verbatim.
bench/datasets/primary/
bench/results/primary/

# Presence-only visibility records, kept on disk but out of the tracked history:
# the bench judges rendering quality now, and these runs are not comparable.
bench/results/*/visibility/_archive-presence-only/

# Video bug-hunting harness: recordings are private product footage and results
# quote model output about them verbatim, so neither is tracked.
bench/video/videos/*
!bench/video/videos/.gitkeep
bench/video/results/
