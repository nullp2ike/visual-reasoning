node_modules/
dist/
coverage/
.env
*.tgz
*.tsbuildinfo
.DS_Store
.history/

# Benchmark datasets and results are local-only. Screenshots under test are
# usually private product UI, and run records quote model output about them
# verbatim, so neither belongs in a shared repository. The `example` and
# `visibility-example` datasets are the exceptions: both are synthetic and
# committed so `pnpm bench:run` / `pnpm visibility:run` work on a fresh clone.
bench/datasets/*
!bench/datasets/example/
!bench/datasets/visibility-example/
!bench/datasets/README.md
bench/results/

# Video bug-hunting harness: recordings are private product footage and results
# quote model output about them verbatim, so neither is tracked.
bench/video/videos/*
!bench/video/videos/.gitkeep
bench/video/results/
